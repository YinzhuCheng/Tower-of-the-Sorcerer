{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix prototypes/c-harbor-3d run check",
  "outputDirectory": "prototypes/c-harbor-3d/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "framework": null,
  "installCommand": "npm --prefix prototypes/c-harbor-3d ci --ignore-scripts"
}
