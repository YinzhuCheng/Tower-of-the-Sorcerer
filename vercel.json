{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:preview:b",
  "outputDirectory": "dist-b-preview",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "framework": null
}
