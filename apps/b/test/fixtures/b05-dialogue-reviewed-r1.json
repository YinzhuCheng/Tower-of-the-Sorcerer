  "scenes": [
    {
      "id": "b05_pre",
      "title": "暖溪取水口",
      "regionId": "B-05",
      "backdropAssetId": "B_ENV_05:pre",
      "choices": [],
      "directives": [
        {
          "sourceLine": 291,
          "text": "【动态提示：预览威胁新水管的维护偶与可用路线。】"
        }
      ],
      "turns": [
        {
          "id": "b05_pre.L279",
          "sourceLine": 279,
          "speaker": "旁白",
          "portrait": null,
          "branch": "common",
          "phase": null,
          "kind": "narration",
          "expression": null,
          "originalText": "维护根偶正把新装的普通水管往外顶。它每次收回木臂，管口就被扯离石槽一点；施工队只能把固定绳拉紧。",
          "originalTextSha256": "9c0c30a0ca6aaf22ce2ae0dffa20c25c8447898c4a2042d6006e2fa3c0d92be4",
          "proposedText": "林子在水边让开一小片空地。石堤下的水缓缓流着，维护根偶却把新装的普通水管一下一下往外顶；管口快要脱开石槽，工队把固定绳绷得笔直。",
          "proposedTextSha256": "d691eec0883843a8a663119105f98923edc4d25c5bbe13c68141f351676d5aa1",
          "changed": true
        },
        {
          "id": "b05_pre.L281",
          "sourceLine": 281,
          "speaker": "工队住民",
          "portrait": null,
          "branch": "common",
          "phase": null,
          "kind": "dialogue",
          "expression": null,
          "originalText": "它一直把新管当成堵塞。再顶两次，接口就裂了。",
          "originalTextSha256": "6cf303731d99f200f31655789e8e9f926e9090a1a36d723a019cab0c44510f93",
          "proposedText": "它一直顶这根新管。绳子快撑不住了！",
          "proposedTextSha256": "6eafa77f6033362bee371fdc84121bd70c9f1027bf19c159038864e603fa2235",
          "changed": true
        },
        {
          "id": "b05_pre.L283",
          "sourceLine": 283,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": null,
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "（让完整圆环星盘停在管边）旧指令还在：这条暖水道不许被别的东西碰。",
          "originalTextSha256": "77659e78ba96733b2e4272709ca9348fcba61b2a373df236ece627f342c8d46c",
          "proposedText": "（让星盘停在管边）它还护着旧暖水道，不肯让新管靠近。",
          "proposedTextSha256": "c0a98a9831638927f575735ae22dbb4bc6ccfce906cb41040a68a1e08d81dfbb",
          "changed": true
        },
        {
          "id": "b05_pre.L285",
          "sourceLine": 285,
          "speaker": "璃",
          "portrait": "hero",
          "branch": "common",
          "phase": null,
          "kind": "dialogue",
          "expression": "guarded",
          "originalText": "能从这里关掉吗？",
          "originalTextSha256": "edca8f6256850f4dba0233570898a5aa7a31158c084dd7bc48be7b37bb1ab33e",
          "proposedText": "能从这里关掉吗？",
          "proposedTextSha256": "edca8f6256850f4dba0233570898a5aa7a31158c084dd7bc48be7b37bb1ab33e",
          "changed": false
        },
        {
          "id": "b05_pre.L287",
          "sourceLine": 287,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": null,
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "控制线压在它的底座下面。得先让它停。",
          "originalTextSha256": "c2677d3f7610e496b53725143987559ac6c9d65cdc995065249a70e28ffc22ba",
          "proposedText": "控制线压在它的底座下面。得先让它停。",
          "proposedTextSha256": "c2677d3f7610e496b53725143987559ac6c9d65cdc995065249a70e28ffc22ba",
          "changed": false
        },
        {
          "id": "b05_pre.L289",
          "sourceLine": 289,
          "speaker": "璃",
          "portrait": "hero",
          "branch": "common",
          "phase": null,
          "kind": "dialogue",
          "expression": "guarded",
          "originalText": "大家松手以后退到那块石墙后。我把它引离管口。",
          "originalTextSha256": "79dc310c32ed91b388a5cf9bcf81e33f9acaa7e28cfc634ed6f086286dbb7b91",
          "proposedText": "大家一起松手，退到那块石墙后。别再拉了，我来把它引开。",
          "proposedTextSha256": "980331bde333b8c07b27925e8aa80cadec0fcd8e3b4642b75f4c4f7d62bbf9a7",
          "changed": true
        }
      ]
    },
    {
      "id": "b05_valve",
      "title": "第一处支阀",
      "regionId": "B-05",
      "backdropAssetId": "B_ENV_05:valve",
      "choices": [],
      "directives": [
        {
          "sourceLine": 325,
          "text": "【动态提示：第一处支阀已关闭，扣除一份保留暖脂；普通水管接通。该状态永久保留。】"
        }
      ],
      "turns": [
        {
          "id": "b05_valve.L295",
          "sourceLine": 295,
          "speaker": "旁白",
          "portrait": null,
          "branch": "common",
          "phase": "valve",
          "kind": "narration",
          "expression": null,
          "originalText": "根偶停下。工队扶正水管，纱雾把一份主路暖脂送入旧槽。活根缓缓放开阀轴，璃与工队共同转动手柄，机械锁落下。",
          "originalTextSha256": "6afd13b7d4ce392026cfe8b4b0faf3c87bd52b1f18b58ba374f884b372c205f1",
          "proposedText": "根偶停下。工队扶正水管，纱雾把一份主路暖脂送入旧槽。活根缓缓放开阀轴，璃与工队共同转动手柄，机械锁落下。",
          "proposedTextSha256": "6afd13b7d4ce392026cfe8b4b0faf3c87bd52b1f18b58ba374f884b372c205f1",
          "changed": false
        },
        {
          "id": "b05_valve.L297",
          "sourceLine": 297,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": "valve",
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "锁住了。现在接普通管。",
          "originalTextSha256": "335420bdd0eb309e87060ec1dd392c8a347246bb81ee2ec69901046bad543db0",
          "proposedText": "锁住了。现在接普通管。",
          "proposedTextSha256": "335420bdd0eb309e87060ec1dd392c8a347246bb81ee2ec69901046bad543db0",
          "changed": false
        },
        {
          "id": "b05_valve.L299",
          "sourceLine": 299,
          "speaker": "旁白",
          "portrait": null,
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "narration",
          "expression": null,
          "originalText": "溪口的白汽渐渐变薄。水仍从石缝里流出来。",
          "originalTextSha256": "589177f715b7d13240f9b05af011e0ba7f9cfa7583450bff41c7c452813e21ce",
          "proposedText": "溪口的白汽渐渐变薄。水仍从石缝里流出来。",
          "proposedTextSha256": "589177f715b7d13240f9b05af011e0ba7f9cfa7583450bff41c7c452813e21ce",
          "changed": false
        },
        {
          "id": "b05_valve.L301",
          "sourceLine": 301,
          "speaker": "璃",
          "portrait": "hero",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "guarded",
          "originalText": "冷了？",
          "originalTextSha256": "ff32db09e9471f3b2b88d8dd49261dcaa566912cfc343b7ad3b4901d159b0c90",
          "proposedText": "冷了？",
          "proposedTextSha256": "ff32db09e9471f3b2b88d8dd49261dcaa566912cfc343b7ad3b4901d159b0c90",
          "changed": false
        },
        {
          "id": "b05_valve.L303",
          "sourceLine": 303,
          "speaker": "旁白",
          "portrait": null,
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "narration",
          "expression": null,
          "originalText": "纱雾把手伸进溪水，凉意一下爬上手腕，她很快抽了回来。看见璃蹲下，她又试着将指尖放进去。",
          "originalTextSha256": "879182260f87a657bd34aaa957fea68abf8811f3b02cdd385c0dab459dc56134",
          "proposedText": "纱雾把手伸进溪水，凉意一下爬上手腕，她很快抽了回来。看见璃蹲下，她又试着将指尖放进去。",
          "proposedTextSha256": "879182260f87a657bd34aaa957fea68abf8811f3b02cdd385c0dab459dc56134",
          "changed": false
        },
        {
          "id": "b05_valve.L305",
          "sourceLine": 305,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "真凉。以前这条溪，冬天洗手都不用缩着。",
          "originalTextSha256": "c58d17472b28973f96d0712690e696c9256851e1688690b1762aaebe52bd50e2",
          "proposedText": "真凉。以前这条溪，冬天洗手都不用缩着。",
          "proposedTextSha256": "c58d17472b28973f96d0712690e696c9256851e1688690b1762aaebe52bd50e2",
          "changed": false
        },
        {
          "id": "b05_valve.L307",
          "sourceLine": 307,
          "speaker": "璃",
          "portrait": "hero",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "guarded",
          "originalText": "要不要擦干？手一直湿着，风吹过来更冷。",
          "originalTextSha256": "f8f997546710cab73a706e6a79c4e6a56ef7e07f54bbfd14bfc09ce0a533d682",
          "proposedText": "要不要擦干？手一直湿着，风吹过来更冷。",
          "proposedTextSha256": "f8f997546710cab73a706e6a79c4e6a56ef7e07f54bbfd14bfc09ce0a533d682",
          "changed": false
        },
        {
          "id": "b05_valve.L309",
          "sourceLine": 309,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "再等一下。我以前路过河谷，总把手收在袖子里，觉得回村就好了。现在连这里也要这样了。",
          "originalTextSha256": "5fd21427f64081f9a251e2595186e4852e6dd0bdfabed5b753a1b6bb40d87043",
          "proposedText": "再等一下。以前从河谷回来，我总要在这里洗手。村里的水，一直是暖的。",
          "proposedTextSha256": "85bb5ab398e05901d776a8b4eff53692369a224e242c4cecb8f0c77df3b8b13a",
          "changed": true
        },
        {
          "id": "b05_valve.L311",
          "sourceLine": 311,
          "speaker": "旁白",
          "portrait": null,
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "narration",
          "expression": null,
          "originalText": "璃蹲在她旁边，指尖掠过水面。",
          "originalTextSha256": "91398ad9455dbfbe4667b1cc7ddd211e8d5ca381941a9ed66bb6ca0943344c7d",
          "proposedText": "璃蹲在她旁边，指尖掠过水面。",
          "proposedTextSha256": "91398ad9455dbfbe4667b1cc7ddd211e8d5ca381941a9ed66bb6ca0943344c7d",
          "changed": false
        },
        {
          "id": "b05_valve.L313",
          "sourceLine": 313,
          "speaker": "璃",
          "portrait": "hero",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "guarded",
          "originalText": "下次洗菜，我来提桶热水兑着。总有办法，不用每回都把手泡红。",
          "originalTextSha256": "a134aa701b2bb56d430b11483516bf352a708e928927d9717ef31b19e7a9f7ba",
          "proposedText": "下次洗菜，我来提桶热水兑着。总有办法，不用每回都把手泡红。",
          "proposedTextSha256": "a134aa701b2bb56d430b11483516bf352a708e928927d9717ef31b19e7a9f7ba",
          "changed": false
        },
        {
          "id": "b05_valve.L315",
          "sourceLine": 315,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "（笑了一下）我还没想到洗菜呢，你已经要提水了。",
          "originalTextSha256": "e6e828b5706883cb4c40fff06ee32ded37f50602e728dd5bbc7e88ad84851a7b",
          "proposedText": "（笑了一下）我还没想到洗菜呢，你已经要提水了。",
          "proposedTextSha256": "e6e828b5706883cb4c40fff06ee32ded37f50602e728dd5bbc7e88ad84851a7b",
          "changed": false
        },
        {
          "id": "b05_valve.L317",
          "sourceLine": 317,
          "speaker": "璃",
          "portrait": "hero",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "guarded",
          "originalText": "刚才看见你缩手，就想到了。冷得难受的时候，别硬撑。",
          "originalTextSha256": "ff47892ab818c42d06df3054a746cbfcf452279038a34f40cc18406e5bfd77fe",
          "proposedText": "刚才看见你缩手，就想到了。冷得难受的时候，别硬撑。",
          "proposedTextSha256": "ff47892ab818c42d06df3054a746cbfcf452279038a34f40cc18406e5bfd77fe",
          "changed": false
        },
        {
          "id": "b05_valve.L319",
          "sourceLine": 319,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "嗯。刚才根一暗，我心里空了一下，还以为水也会跟着没了。",
          "originalTextSha256": "9d17e7abf7dd9664e2fabe93f8529c662ec98ae43bd00adde8c2f41f61c27f41",
          "proposedText": "嗯。刚才根一暗，我吓了一跳，还以为连水也要没了。",
          "proposedTextSha256": "9799992abffecdda9d4c340872d7724c8fb7ed3cec6c8ab80372d8489f14e9fc",
          "changed": true
        },
        {
          "id": "b05_valve.L321",
          "sourceLine": 321,
          "speaker": "旁白",
          "portrait": null,
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "narration",
          "expression": null,
          "originalText": "水仍从石缝间流出来，绕过她的手指。纱雾等了一会儿，慢慢把手抽回来，甩掉指尖的水。",
          "originalTextSha256": "2b46269200d98e839849235099a736a5a8f4f1fd4eee6348db94d97d42ff8d48",
          "proposedText": "水仍从石缝间流出来，绕过她的手指。纱雾等了一会儿，慢慢把手抽回来，甩掉指尖的水。",
          "proposedTextSha256": "2b46269200d98e839849235099a736a5a8f4f1fd4eee6348db94d97d42ff8d48",
          "changed": false
        },
        {
          "id": "b05_valve.L323",
          "sourceLine": 323,
          "speaker": "纱雾",
          "portrait": "guide",
          "branch": "common",
          "phase": "pipeWorks",
          "kind": "dialogue",
          "expression": "gentle",
          "originalText": "还好，它还在流。回去要跟学舍说一声，记得烧热水。",
          "originalTextSha256": "e94bc984bc7c34d6bf75a2cbcc99a5d078e74f0fe6993dbe3196c1b6cb512026",
          "proposedText": "还好，它还在流。回去要跟学舍说一声，记得烧热水。",
          "proposedTextSha256": "e94bc984bc7c34d6bf75a2cbcc99a5d078e74f0fe6993dbe3196c1b6cb512026",
          "changed": false
        }
      ]
    },
